#include <stdio.h>

void find_flower_indices(int n, int t, int arr[], int result[2]) {
    int left = 0;
    int right = n - 1;
    
    while (left < right) {
        int current_sum = arr[left] + arr[right];
        
        if (current_sum == t) {
            result[0] = left;
            result[1] = right;
            return; // Found the first occurrence matching the sum
        } else if (current_sum < t) {
            left++; // Sum is too small, move the left pointer to increase sum
        } else {
            right--; // Sum is too large, move the right pointer to decrease sum
        }
    }
}

int main() {
    int n, t;
    scanf("%d %d", &n, &t);
    int arr[n];
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    int result[2];
    find_flower_indices(n, t, arr, result);
    printf("%d %d", result[0], result[1]);
    return 0;
}
