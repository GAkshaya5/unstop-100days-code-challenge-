#include <stdio.h>

int find_largest_pack(int N) {
// Keep shifting N right until it becomes 0, counting the number of positions
int power = 1;
while (N > 1) {
N >>= 1;
power <<= 1;
}
return power;
}

int main() {
int N;
scanf("%d", &N);
int result = find_largest_pack(N);
printf("%d\n", result);
return 0;
}
