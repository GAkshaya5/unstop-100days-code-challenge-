#include <stdio.h>
#include <stdlib.h>
#include <math.h>

// Helper function to find the minimum of two long long values
long long min_val(long long a, long long b) {
    return (a < b) ? a : b;
}

long long min_cost(long long v[], int n) {
    if (n <= 1) return 0;

    // dp[i] will store the minimum cost to reach index i
    long long dp[n];
    
    // Base case: cost to reach the first element is 0
    dp[0] = 0;

    for (int i = 1; i < n; i++) {
        // Option 1: jump from i-1
        dp[i] = dp[i - 1] + llabs(v[i] - v[i - 1]);

        // Option 2: jump from i-2 (if valid)
        if (i >= 2) {
            dp[i] = min_val(dp[i], dp[i - 2] + llabs(v[i] - v[i - 2]));
        }

        // Option 3: jump from i-3 (if valid)
        if (i >= 3) {
            dp[i] = min_val(dp[i], dp[i - 3] + llabs(v[i] - v[i - 3]));
        }
    }

    return dp[n - 1];
}

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;

    long long v[n];
    for (int i = 0; i < n; i++) {
        scanf("%lld", &v[i]);
    }

    long long result = min_cost(v, n);
    printf("%lld\n", result);

    return 0;
}
