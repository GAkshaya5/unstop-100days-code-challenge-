#include <stdio.h>
#include <stdlib.h>

void modify_array(int n, int arr[]) {
    int max_val = 0;
    
    for (int i = 0; i < n; i++) {
        // Update the maximum value encountered up to the current index
        if (arr[i] > max_val) {
            max_val = arr[i];
        }
        // Increase the current element by the maximum value encountered so far
        arr[i] += max_val;
    }
}

int main() {
    int n;
    scanf("%d", &n);
    int *arr = (int *)malloc(n * sizeof(int));
    for(int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    modify_array(n, arr);
    for(int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    free(arr);
    return 0;
}
