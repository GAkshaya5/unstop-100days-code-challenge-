#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;
    
    int *a = (int *)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &a[i]) != 1) {
            free(a);
            return 0;
        }
    }
    
    int k;
    if (scanf("%d", &k) != 1) {
        free(a);
        return 0;
    }
    
    int less_than_k = 0;
    int equal_to_k = 0;
    
    // Count elements less than K and equal to K
    for (int i = 0; i < n; i++) {
        if (a[i] < k) {
            less_than_k++;
        } else if (a[i] == k) {
            equal_to_k++;
        }
    }
    
    // Output total count of matching indices
    printf("%d\n", equal_to_k);
    
    // Output the space-separated sorted indices
    for (int i = 0; i < equal_to_k; i++) {
        printf("%d", less_than_k + i);
        if (i < equal_to_k - 1) {
            printf(" ");
        }
    }
    printf("\n");
    
    free(a);
    return 0;
}
