#include <stdio.h>
#include <stdlib.h>

int peakIndexInMountainArray(int* A, int ASize) {
    int low = 0;
    int high = ASize - 1;
    
    while (low < high) {
        int mid = low + (high - low) / 2;
        
        // If the middle element is less than the next element,
        // we are still in the ascending slope.
        if (A[mid] < A[mid + 1]) {
            low = mid + 1;
        } 
        // Otherwise, we are either at the peak or on the descending slope.
        else {
            high = mid;
        }
    }
    
    return low;
}

int main() {
    int n;
    // Read the size of the array
    if (scanf("%d", &n) != 1) return 0;
    
    int* arr = (int*)malloc(n * sizeof(int));
    
    // Read the n-spaced integers denoting the array
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &arr[i]) != 1) {
            free(arr);
            return 0;
        }
    }
    
    // Find and print the class_id (peak index)
    int result = peakIndexInMountainArray(arr, n);
    printf("%d\n", result);
    
    free(arr);
    return 0;
}
