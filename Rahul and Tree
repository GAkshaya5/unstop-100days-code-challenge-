#include <stdio.h>
#include <stdlib.h>

// Structure for the tree node
typedef struct Node {
    int data;
    struct Node* left;
    struct Node* right;
} Node;

// Comparator function for qsort to sort the array in ascending order
int compare(const void* a, const void* b) {
    return (*(int*)a - *(int*)b);
}

// Function to build a height-balanced BST from a sorted array
Node* buildBalancedBST(int arr[], int start, int end) {
    if (start > end) {
        return NULL;
    }
    
    // Use ceiling division to match the platform's choice of mid element
    int mid = start + (end - start + 1) / 2;
    
    Node* root = (Node*)malloc(sizeof(Node));
    root->data = arr[mid];
    
    // Recursively construct left and right subtrees
    root->left = buildBalancedBST(arr, start, mid - 1);
    root->right = buildBalancedBST(arr, mid + 1, end);
    
    return root;
}

// Function for pre-order traversal and formatting the output
void preOrderTraversal(Node* root) {
    if (root == NULL) {
        return;
    }
    
    // Check left child
    if (root->left != NULL) {
        printf("%d <- ", root->left->data);
    } else {
        printf(". <- ");
    }
    
    // Print the current node
    printf("%d", root->data);
    
    // Check right child
    if (root->right != NULL) {
        printf(" -> %d\n", root->right->data);
    } else {
        printf(" -> .\n");
    }
    
    // Recurse to left and right subtrees
    preOrderTraversal(root->left);
    preOrderTraversal(root->right);
}

// Helper function to free allocated memory
void freeTree(Node* root) {
    if (root == NULL) return;
    freeTree(root->left);
    freeTree(root->right);
    free(root);
}

int main() {
    int N;
    if (scanf("%d", &N) != 1) return 0;
    
    int* arr = (int*)malloc(N * sizeof(int));
    for (int i = 0; i < N; i++) {
        if (scanf("%d", &arr[i]) != 1) return 0;
    }
    
    // Step 1: Sort the array to be able to create a balanced BST
    qsort(arr, N, sizeof(int), compare);
    
    // Step 2: Build the balanced tree
    Node* root = buildBalancedBST(arr, 0, N - 1);
    
    // Step 3: Print the pre-order traversal with arrow formatting
    preOrderTraversal(root);
    
    // Clean up memory
    freeTree(root);
    free(arr);
    
    return 0;
}
